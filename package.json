{
  "name": "portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:contract": "vitest --run contract.test.ts",
    "test:ui-tests": "vitest --run ui.test.ts",
    "test:a11y": "vitest --run accessibility.test.ts",
    "test:perf": "vitest --run performance.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "generate-blur-lqip": "node scripts/generate-blur-lqip.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
